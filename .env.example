# ============================================================================
# FFmpeg API - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)
# ============================================================================

# -----------------------------------------------------------------------------
# API Authentication
# -----------------------------------------------------------------------------
# Comma-separated list of valid API keys for X-Internal-API-Key header
INTERNAL_API_KEYS=your-secret-api-key-1,your-secret-api-key-2

# -----------------------------------------------------------------------------
# DigitalOcean Spaces Configuration
# -----------------------------------------------------------------------------
# Bucket name
SPACES_BUCKET=your-bucket-name

# Spaces endpoint (region-specific)
# Examples:
#   - London:     https://lon1.digitaloceanspaces.com
#   - New York:   https://nyc3.digitaloceanspaces.com
#   - Singapore:  https://sgp1.digitaloceanspaces.com
SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com

# Spaces access credentials
SPACES_ACCESS_KEY_ID=your-spaces-access-key-id
SPACES_SECRET_ACCESS_KEY=your-spaces-secret-access-key

# Public base URL for uploaded files (optional)
# If set, API will return public URLs in concat_spaces responses
# If not set, output_url will be null
SPACES_PUBLIC_BASE_URL=https://your-bucket-name.lon1.digitaloceanspaces.com

# -----------------------------------------------------------------------------
# Valkey (Redis-compatible) Configuration
# -----------------------------------------------------------------------------
# Valkey connection URL
# For Docker Compose: use service name 'valkey'
VALKEY_URL=redis://valkey:6379

# Alternative for local testing (when running outside compose):
# VALKEY_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
# Optional Configuration
# -----------------------------------------------------------------------------
# Media files directory (mounted into ffmpeg-api container)
# Default: /root/media-files
MEDIA_DIR=/root/media-files
